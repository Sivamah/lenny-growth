# Frontend environment variables (copy to .env.local for local dev)

# ---------------------------------------------------------------------------
# VITE_API_BASE_URL
# Base URL for the FastAPI backend.
#
# Option A — Vite dev proxy (recommended for local dev):
#   Set to empty string. The Vite dev server will proxy /health, /api, /sessions
#   to VITE_PROXY_TARGET (see below). The browser never knows the backend port.
#   VITE_API_BASE_URL=
#
# Option B — Direct (when not using Vite proxy, e.g. static hosting):
#   Set to the full backend URL.
#   VITE_API_BASE_URL=http://localhost:8000
#
# Default: http://localhost:8000 (if variable is not set at all)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=

# ---------------------------------------------------------------------------
# VITE_PROXY_TARGET
# The backend URL that Vite's dev proxy will forward requests to.
# Only used in development (vite.config.ts reads this at build time).
# ---------------------------------------------------------------------------
VITE_PROXY_TARGET=http://localhost:8000
