# Backend environment template. Copy to `.env` and adjust as needed.
# Every value below is a non-secret default that lets the app boot.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Database (required for the real architecture: PostgreSQL + pgvector)
# Docker Compose (when added) points this at the `db` service.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny_growth
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=3

# ---------------------------------------------------------------------------
# Agent service boundary (the existing Node.js Pi agent-service)
# FastAPI owns persistence + retrieval; Node owns the Pi SDK agent runtime.
# INTERNAL_TOKEN must match the Node service's INTERNAL_TOKEN when set.
# ---------------------------------------------------------------------------
AGENT_SERVICE_URL=http://127.0.0.1:8001
INTERNAL_TOKEN=dev-internal-token
AGENT_REQUEST_TIMEOUT_SECONDS=10
# Read timeout for streaming NDJSON tokens off a /v1/turn response.
AGENT_TURN_TIMEOUT_SECONDS=120
# Newest messages replayed to the agent as distilled history per turn.
CHAT_HISTORY_MAX_MESSAGES=20

# ---------------------------------------------------------------------------
# Embeddings (local Ollama via POST {OLLAMA_BASE_URL}/api/embed)
# nomic-embed-text returns 768 floats, matching EMBEDDING_DIMENSIONS.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Retrieval + chunking sizing
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.60
CHUNK_TARGET_TOKENS=280
CHUNK_OVERLAP_TOKENS=40
