# agent-service environment template. Copy to `.env` (git-ignored) and adjust.

# --- HTTP server ---
AGENT_HOST=127.0.0.1
AGENT_PORT=8001

# --- Ollama (chat + shared embeddings host) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Optional Anthropic provider ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- FastAPI retrieval boundary ---
# Endpoint implemented by the backend. Real retrieval is the default.
RETRIEVAL_URL=http://127.0.0.1:8000/internal/retrieve
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.60
RETRIEVAL_TIMEOUT_MS=15000
# Set true ONLY for development/testing without the backend. Mock results are
# marked source="mock" and prefixed "[MOCK RETRIEVAL - NOT REAL TRANSCRIPTS]".
RETRIEVAL_MOCK=false

# Shared secret for /v1/* and sent to the backend as X-Internal-Token.
# Must match the backend's INTERNAL_TOKEN. Leave unset to disable on both sides.
INTERNAL_TOKEN=dev-internal-token
